# Local development defaults. Copy to server/.env only on your machine.
NODE_ENV=development
PORT=5000
DB_TYPE=json

# Configure these when using MySQL.
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Admin access is disabled until all three values are configured.
# Use a unique password (12+ characters) and a random session secret (32+ bytes).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Optional email delivery settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# ADMIN_EMAIL=

# Optional: set uploads to a persistent writable directory.
# UPLOAD_DIR=
